APP_NAME="TSITA GEST"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8010
# Stockage en UTC ; conversion Africa/Brazzaville dans les services et ressources.
APP_TIMEZONE=UTC
APP_BUSINESS_TIMEZONE=Africa/Brazzaville
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
# Mode démonstration : autorise les règles de délai source_type=demonstration non validées.
APP_DEMO_MODE=true
# --- Sécurité (docs/SECURITE.md) ---
# MFA imposée aux rôles listés (hors démo : toujours active). Liste séparée par des virgules.
MFA_ENFORCED_ROLES=conformite,admin,responsable,direction
# En démo UNIQUEMENT (APP_DEMO_MODE=true) : false = imposition désactivée pour les démonstrations.
# Ignoré hors démo. En production : APP_DEMO_MODE=false (imposition toujours active).
MFA_ENFORCE_IN_DEMO=false
LOGIN_MAX_PER_IP_PER_MINUTE=20
TRACKING_MAX_FAILURES_PER_REFERENCE=5
TRACKING_MAX_FAILURES_PER_IP=30

FRONTEND_URL=http://localhost:5180

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tsita_gest
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=localhost:5180,127.0.0.1:5180
CORS_ALLOWED_ORIGINS=http://localhost:5180,http://127.0.0.1:5180

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@bsca.demo"
MAIL_FROM_NAME="${APP_NAME}"
